/in/*
/in_b/*
/out/*
/out_b/*
/relatorio/*
/filtros/*

!/in/.gitkeep
!/in_b/.gitkeep
!/out/.gitkeep
!/out_b/.gitkeep
!/relatorio/.gitkeep
!/filtros/.gitkeep

/.env

__pycache__/
*.pyc
.pytest_cache/

# Automacao de disparo (auto/)
/auto/node_modules/
/auto/logs/*
!/auto/logs/.gitkeep
# Numero de template por grupo: muda quase toda rodada, nao versiona.
# Semeado de template-numeros.example.json na primeira leitura.
/auto/config/template-numeros.json
/auto/config/template-numeros-b.json
/auto/scripts/out/
/auto/old-bases-old/

# Projeto de referencia, nao versionado
/Base_disparo/
